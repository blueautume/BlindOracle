    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于自动取得本次起卦地点，按当地经度换算真太阳时；你也可以手动选择地点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BlindOracle uses your location to fill the casting place and calculate local apparent solar time. You can also choose a place manually."
          }
        }
      }
